{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-cli-review-1.schema.json",
  "title": "tine review ACTION --json",
  "description": "Every `tine review` action. `create`/`add`: the new `version` and its `digest`; `gate`: the signed `decision`, its `digest` and the `gate` check; `show`, `export`, `verify`: `result`, the bundle check (`show` adds the head `version`); `import`: `added`; `push`: `versions`, `decisions`, `head`; `run` (0.48): the reviewer fleet's `fleet`, `fleet_id`, `exit_code`, `members`, the signed `findings` (each checked), the lines `skipped` and the new `head`; `findings`: the stored `findings`, each checked. A refusal is the error envelope, exit 4 for a verification failure.",
  "type": "object",
  "required": [
    "command",
    "action",
    "ok"
  ],
  "properties": {
    "command": {
      "const": "review"
    },
    "action": {
      "enum": [
        "create",
        "add",
        "gate",
        "show",
        "export",
        "verify",
        "import",
        "push",
        "run",
        "findings"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "version": {
      "$ref": "opentine-review-1.schema.json"
    },
    "decision": {
      "$ref": "opentine-review-gate-1.schema.json"
    },
    "digest": {
      "type": "string",
      "pattern": "^blob:sha256:[0-9a-f]{64}$"
    },
    "gate": {
      "type": "object",
      "required": [
        "review_id",
        "gate",
        "decision",
        "seq",
        "state"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "gate": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "decision": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "review_id",
        "head",
        "seq",
        "versions",
        "decisions",
        "gates",
        "status",
        "state"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "head": {
          "type": "string",
          "pattern": "^blob:sha256:[0-9a-f]{64}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "versions": {
          "type": "integer",
          "minimum": 0
        },
        "decisions": {
          "type": "integer",
          "minimum": 0
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "approved",
              "rejected",
              "pending"
            ]
          }
        },
        "status": {
          "enum": [
            "approved",
            "rejected",
            "pending"
          ]
        },
        "state": {
          "type": "string"
        }
      }
    },
    "added": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions",
        "decisions"
      ],
      "properties": {
        "versions": {
          "type": "integer",
          "minimum": 0
        },
        "decisions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "versions": {
      "type": "integer",
      "minimum": 0
    },
    "decisions": {
      "type": "integer",
      "minimum": 0
    },
    "head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^blob:sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "fleet": {
      "type": "string"
    },
    "fleet_id": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "state"
        ],
        "properties": {
          "finding_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "verified",
              "verified-tofu",
              "failed"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 100000
    }
  }
}
