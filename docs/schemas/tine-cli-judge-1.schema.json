    {
      "type": "object",
      "required": [
        "command",
        "schema",
        "labels",
        "members",
        "independence",
        "rows",
        "advisories",
        "counts"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-judge/1"
        },
        "command": {
          "const": "judge classify"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
