                        }
                      ]
                    },
                    "probability": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reason": {
                      "type": "string"
                    },
                    "judge_run": {
                      "type": "string"
                    },
                    "votes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "groups": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
