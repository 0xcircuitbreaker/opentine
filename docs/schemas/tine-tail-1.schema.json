{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-tail-1.schema.json",
  "title": "tine-tail/1",
  "description": "One live-tail row (0.77, docs/LIVE.md): the `data:` of an SSE frame on `GET /v1/tenants/<t>/tail` and the `row` of `tine log -f --json`. `event` rows name a durable event and its verification status (`verified` only when its bytes hash to its id and every linked object is present); `rewrite` says a followed ref no longer extends the run seen before; `reset` an unreadable resume point; `dropped` a slow consumer cut off; `truncated` that more run refs exist than are followed. A message format, not an object kind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "type",
    "ref",
    "run_id",
    "index",
    "event_id",
    "kind",
    "status",
    "verified",
    "time_unix",
    "detail"
  ],
  "properties": {
    "format": {
      "const": "tine-tail/1"
    },
    "type": {
      "enum": [
        "event",
        "rewrite",
        "reset",
        "dropped",
        "truncated"
      ]
    },
    "ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        null,
        "verified",
        "unverified",
        "invalid"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "time_unix": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
