              "type": "null"
            }
          ]
        },
        "margin_bits": {
          "type": "integer"
        },
        "blocking": {
          "type": "integer",
          "minimum": 0
        },
        "judged": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canary_sha256",
              "holdout",
              "code_bits",
              "entropy_bits",
