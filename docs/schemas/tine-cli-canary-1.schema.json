{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-cli-canary-1.schema.json",
  "title": "tine dataset canary-add|canary-list|canary-check|contamination --json",
  "description": "Canaries and contamination for sealed holdouts. `canary-add` signs a canary registration (claim convention `opentine.integrity.canary`) with a declared entropy in bits; `counted` is true when the signer holds the dataset role, not the optimizer role, in pinned key roles. Outputs never repeat a canary's text. `canary-check` reads per-canary code lengths from a scoring run and refuses (`dataset.canary-below-entropy`, `ok` false, exit 1) when a counted canary is coded below `entropy_bits - margin_bits`; other findings are advisory (D12). `contamination` reports exact blob-oid matches and word 5-gram MinHash near-duplicates whose exact Jaccard is at or above the recorded threshold.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "ok",
        "canary"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-canary/1"
        },
        "command": {
          "const": "dataset canary-add"
        },
        "ok": {
          "const": true
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canary_sha256",
            "entropy_bits",
            "bytes",
            "holdout",
            "signer",
            "counted"
          ],
          "properties": {
            "canary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "entropy_bits": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "holdout": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "signer": {
              "type": "string"
            },
            "counted": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "ok",
        "canaries"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-canary/1"
        },
        "command": {
          "const": "dataset canary-list"
        },
        "ok": {
          "const": true
        },
        "canaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canary_sha256",
              "entropy_bits",
              "bytes",
              "holdout",
              "signer",
              "counted"
            ],
            "properties": {
              "canary_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "entropy_bits": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "holdout": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "signer": {
                "type": "string"
              },
              "counted": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "ok",
        "model",
        "margin_bits",
        "judged",
        "findings",
        "blocking"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-canary/1"
        },
