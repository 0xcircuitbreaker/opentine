{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/opentine-eval-plan-1.schema.json",
  "title": "opentine.eval-plan/1",
  "description": "The claim of a pre-registered analysis plan: metric, reducer, epochs, test, alpha, multiplicity correction and candidate count, cluster key, minimum detectable effect, coverage floor and the seed commitment. A claim convention on an attestation, not an object kind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset",
    "metric",
    "reducer",
    "epochs",
    "test",
    "alpha",
    "resamples",
    "correction",
    "max_candidates",
    "cluster_key",
    "mde",
    "min_coverage",
    "seed_commitment"
  ],
  "properties": {
    "schema": {
      "const": "opentine.eval-plan/1"
    },
    "dataset": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metric": {
      "enum": [
        "score",
        "pass_rate"
      ]
    },
    "reducer": {
      "enum": [
        "mean",
        "pass@k",
        "pass^k"
      ]
    },
    "epochs": {
      "type": "integer",
      "minimum": 1
    },
    "test": {
      "enum": [
        "paired-bootstrap",
        "permutation"
      ]
    },
    "alpha": {
      "type": "string",
      "pattern": "^(0|1|0\\.[0-9]*[1-9])$"
    },
    "resamples": {
      "type": "integer",
      "minimum": 1
    },
    "correction": {
      "enum": [
        "holm",
        "bonferroni"
      ]
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1
    },
    "cluster_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mde": {
      "type": "string",
      "pattern": "^(0|1|0\\.[0-9]*[1-9])$"
    },
    "min_coverage": {
      "type": "string",
      "pattern": "^(0|1|0\\.[0-9]*[1-9])$"
    },
    "seed_commitment": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
