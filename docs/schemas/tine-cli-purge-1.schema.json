{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-cli-purge-1.schema.json",
  "title": "tine purge --json",
  "description": "One purge: the blob's bytes are gone (`purged`), or it was purged before (`already`); `tombstone` is the signed record kept in their place.",
  "type": "object",
  "required": [
    "command",
    "oid",
    "purged",
    "already",
    "packs_rewritten",
    "tombstone"
  ],
  "properties": {
    "command": {
      "const": "purge"
    },
    "oid": {
      "type": "string",
      "pattern": "^blob:sha256:[0-9a-f]{64}$"
    },
    "purged": {
      "type": "boolean"
    },
    "already": {
      "type": "boolean"
    },
    "packs_rewritten": {
      "type": "integer",
      "minimum": 0
    },
    "tombstone": {
      "$ref": "opentine-tombstone-1.schema.json"
    }
  }
}
