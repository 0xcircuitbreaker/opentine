{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/opentine-weight-custody-refusal-1.schema.json",
  "title": "opentine.weight-custody-refusal/1 entry",
  "description": "One load of a model-organism artifact that `tine custody gate` refused (0.72): a held blob listed in the oversight queue, not an object kind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "convention",
    "artifact",
    "reason",
    "tool",
    "at"
  ],
  "properties": {
    "convention": {
      "const": "opentine.weight-custody-refusal/1"
    },
    "artifact": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "at": {
      "type": "string"
    }
  }
}
