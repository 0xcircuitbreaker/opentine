{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/opentine-stop-policy-1.schema.json",
  "title": "opentine.stop-policy/1 file",
  "description": "A repository's stop policy (`.tine/stop-policy.json`): its fleet, stop channel, the channel's verifier key and the freshness window. A file convention.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "convention",
    "fleet",
    "channel",
    "vkey",
    "window_s",
    "skew_s",
    "watchdog_s"
  ],
  "properties": {
    "convention": {
      "const": "opentine.stop-policy/1"
    },
    "fleet": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "channel": {
      "type": "string"
    },
    "vkey": {
      "type": "string"
    },
    "window_s": {
      "type": "integer",
      "minimum": 0
    },
    "skew_s": {
      "type": "integer",
      "minimum": 0
    },
    "watchdog_s": {
      "type": "integer",
      "minimum": 0
    }
  }
}
