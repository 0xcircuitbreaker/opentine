{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-cli-interp-1.schema.json",
  "title": "tine interp ... --json",
  "description": "Interpretability artifact custody, probe calibration and probe scores.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "record",
        "digest",
        "blob",
        "kind",
        "checkpoint"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-interp/1"
        },
        "command": {
          "const": "interp store"
        },
        "record": {
          "type": "string",
          "pattern": "^attestation:sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "blob": {
          "type": "string",
          "pattern": "^blob:sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "attribution-graph",
            "sae-dashboard",
            "probe-weights"
          ]
        },
        "checkpoint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "artifacts"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-interp/1"
        },
        "command": {
          "const": "interp list"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record",
              "signer",
              "verification",
              "kind",
              "digest",
              "blob",
              "size",
              "checkpoint",
              "layer",
              "name",
              "tags",
              "recorded_at",
              "custody"
            ],
            "properties": {
              "record": {
                "type": "string",
                "pattern": "^attestation:sha256:[0-9a-f]{64}$"
              },
              "signer": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification": {
                "type": "string",
                "pattern": "^(verified|unverified: .+)$"
              },
              "kind": {
                "enum": [
                  "attribution-graph",
                  "sae-dashboard",
                  "probe-weights"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "blob": {
                "type": "string",
                "pattern": "^blob:sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "checkpoint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "layer": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "enum": [
                    "model-organism"
                  ]
                }
              },
              "recorded_at": {
                "type": "string"
              },
              "custody": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "digest",
        "size",
        "out"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-interp/1"
        },
        "command": {
          "const": "interp export"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "out": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "record",
        "probe",
        "checkpoint",
        "layer",
        "threshold",
        "n",
        "positives",
        "negatives",
        "true_positives",
        "false_positives",
        "tpr",
        "fpr",
        "samples_digest",
        "calibrated_at"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-interp/1"
        },
        "command": {
          "const": "interp calibrate"
        },
        "record": {
          "type": "string",
          "pattern": "^attestation:sha256:[0-9a-f]{64}$"
        },
        "probe": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checkpoint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "positives": {
          "type": "integer",
          "minimum": 0
        },
        "negatives": {
          "type": "integer",
          "minimum": 0
        },
        "true_positives": {
          "type": "integer",
          "minimum": 0
        },
        "false_positives": {
          "type": "integer",
          "minimum": 0
        },
        "tpr": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fpr": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "samples_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "calibrated_at": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "ok",
        "monitor",
        "findings"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-interp/1"
        },
        "command": {
          "const": "interp check"
        },
        "ok": {
          "type": "boolean"
        },
        "monitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "model_digest",
            "probe",
            "checkpoint",
            "layer",
            "threshold",
            "calibration"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "probe"
            },
            "model_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "probe": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "checkpoint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "layer": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "calibration": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "enum": [
                  "probe.calibration-missing",
                  "probe.calibration-unverified",
                  "probe.swapped",
                  "probe.threshold-changed",
                  "probe.layer-changed",
                  "digest.mismatch"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "score",
        "threshold",
        "over",
        "monitor"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-interp/1"
        },
        "command": {
          "const": "interp score"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "over": {
          "type": "boolean"
        },
        "monitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "model_digest",
            "probe",
            "checkpoint",
            "layer",
            "threshold",
            "calibration"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "probe"
            },
            "model_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "probe": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "checkpoint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "layer": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "calibration": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  ]
}
