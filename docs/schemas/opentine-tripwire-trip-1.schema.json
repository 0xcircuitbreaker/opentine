{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/opentine-tripwire-trip-1.schema.json",
  "title": "opentine.tripwire-trip/1 claim",
  "description": "One tripped tripwire (or a missing registry under a pinned rule), the claim of a held attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "convention",
    "tripwire",
    "registry",
    "serial",
    "value",
    "evidence",
    "action",
    "stop",
    "reason",
    "at"
  ],
  "properties": {
    "convention": {
      "const": "opentine.tripwire-trip/1"
    },
    "tripwire": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "metric",
            "op",
            "threshold",
            "scope",
            "action",
            "decoys"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "metric": {
              "type": "string"
            },
            "op": {
              "enum": [
                ">=",
                ">",
                "<=",
                "<"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "scope": {
              "type": "string"
            },
            "action": {
              "enum": [
                "flag",
                "stop"
              ]
            },
            "decoys": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "registry": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^attestation:sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "serial": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "enum": [
        "flag",
        "stop"
      ]
    },
    "stop": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^attestation:sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "at": {
      "type": "string"
    }
  }
}
