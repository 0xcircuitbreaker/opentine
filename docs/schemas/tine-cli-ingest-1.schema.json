    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "batch"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-ingest/1"
        },
        "command": {
          "const": "ingest --batch"
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "convention",
            "stream",
            "seq",
            "previous",
            "policy",
            "policy_digest",
            "first_index",
            "next_index",
            "received",
            "captured",
            "dropped",
            "dropped_by",
            "input_sha256",
            "at"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^annotation:sha256:[0-9a-f]{64}$"
            },
            "convention": {
              "const": "opentine.ingest-batch/1"
            },
            "stream": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "previous": {
              "anyOf": [
