                  "type": "string",
                  "pattern": "^annotation:sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy": {
              "type": "string",
              "pattern": "^annotation:sha256:[0-9a-f]{64}$"
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "first_index": {
              "type": "integer",
              "minimum": 0
            },
            "next_index": {
              "type": "integer",
              "minimum": 0
            },
            "received": {
              "type": "integer",
              "minimum": 0
            },
            "captured": {
              "type": "integer",
              "minimum": 0
            },
            "dropped": {
              "type": "integer",
              "minimum": 0
