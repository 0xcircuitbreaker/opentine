                  "minimum": 0
                },
                "rate": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "at": {
              "type": "string",
              "description": "RFC 3339 UTC timestamp"
            }
          }
        }
      }
    },
