{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-watch-1.schema.json",
  "title": "tine watch --json",
  "description": "One JSON Lines record of `tine watch --json`: an event, or a reset (events were missed; re-list refs).",
  "type": "object",
  "required": [
    "command",
    "schema"
  ],
  "properties": {
    "command": {
      "const": "watch"
    },
    "schema": {
      "const": "tine-watch/1"
    },
    "event": {
      "$ref": "tine-event-1.schema.json"
    },
    "reset": {
      "const": true
    }
  },
  "anyOf": [
    {
      "required": [
        "event"
      ]
    },
    {
      "required": [
        "reset"
      ]
    }
  ]
}
