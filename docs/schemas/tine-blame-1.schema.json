{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-blame-1.schema.json",
  "title": "tine-blame/1",
  "description": "`tine blame PATH[:LINE] --json`: the recorded writes that inserted a line or wrote a file.",
  "type": "object",
  "required": [
    "command",
    "path",
    "line",
    "commit",
    "linked_runs",
    "hits"
  ],
  "properties": {
    "command": {
      "const": "blame"
    },
    "schema": {
      "const": "tine-blame/1"
    },
    "path": {
      "type": "string"
    },
    "line": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "commit": {
      "type": "string"
    },
    "linked_runs": {
      "type": "array"
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "step_id",
          "seq",
          "tool",
          "model",
          "agent",
          "ts",
          "path",
          "match"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "tool": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "ts": {
            "type": "number"
          },
          "path": {
            "type": "string"
          },
          "match": {
            "enum": [
              "line",
              "file"
            ]
          },
          "commit": {
            "type": "string"
          }
        }
      }
    }
  }
}
