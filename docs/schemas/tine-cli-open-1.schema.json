{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-cli-open-1.schema.json",
  "title": "tine open --json",
  "description": "The web page `tine open` would open for a run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "run",
    "tenant",
    "url"
  ],
  "properties": {
    "command": {
      "const": "open"
    },
    "run": {
      "type": "string",
      "pattern": "^[a-z]+:sha256:[0-9a-f]{64}$"
    },
    "tenant": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  }
}
