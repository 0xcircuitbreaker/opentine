{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-cli-memory-1.schema.json",
  "title": "tine memory ACTION --json",
  "description": "Every `tine memory` action. `add`: `note` (the check) and the signed `record`; `list`/`recall`: `notes` (checks with `text`, `author`, `created_at`) and `team`, the number of trusted keys; `trust`: `team`, the trusted keys.",
  "type": "object",
  "required": [
    "command",
    "action",
    "ok"
  ],
  "properties": {
    "command": {
      "const": "memory"
    },
    "action": {
      "enum": [
        "add",
        "list",
        "recall",
        "trust"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "note": {
      "type": "object",
      "required": [
        "scope",
        "topic",
        "digest",
        "signer",
        "subject",
        "supersedes",
        "tags",
        "state"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^blob:sha256:[0-9a-f]{64}$"
        },
        "signer": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(run|blob):sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^blob:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
          }
        },
        "state": {
          "enum": [
            "verified",
            "verified-tofu"
          ]
        },
        "text": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/@+-]{1,256}$"
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "record": {
      "$ref": "opentine-memory-1.schema.json"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "topic",
          "digest",
          "signer",
          "subject",
          "supersedes",
          "tags",
          "state"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "topic": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^blob:sha256:[0-9a-f]{64}$"
          },
          "signer": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(run|blob):sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^blob:sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
            }
          },
          "state": {
            "enum": [
              "verified",
              "verified-tofu"
            ]
          },
          "text": {
            "type": "string"
          },
          "author": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/@+-]{1,256}$"
          },
          "created_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    },
    "team": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      ]
    }
  }
}
