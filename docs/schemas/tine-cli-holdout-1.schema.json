              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "ok",
        "refusals"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-holdout/1"
        },
