              "detail"
            ],
            "properties": {
              "code": {
                "enum": [
                  "lineage.variant-unknown",
                  "lineage.record-invalid",
                  "lineage.parent-missing",
                  "lineage.cycle",
                  "lineage.evidence-missing",
                  "lineage.decision-mismatch",
                  "lineage.signer-untrusted",
                  "lineage.score-tainted",
                  "lineage.memory-quarantined"
                ]
              },
              "variant": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
