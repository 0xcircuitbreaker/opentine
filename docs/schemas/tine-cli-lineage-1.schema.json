{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentine.com/schemas/tine-cli-lineage-1.schema.json",
  "title": "tine lineage record|check|graph|why|archive|index --json",
  "description": "The self-modification lineage of a self-improving agent loop. `record` names the variant id it signed (claim convention `opentine.lineage.variant`), the record file, its parents, justifying evals and cited decision. `check` walks the variant's ancestry over the lineage folder: `ancestors` in depth-first order, `findings` each a `lineage.*` code about one variant; `ok` only when there is none (exit 1 otherwise). `signers` is `pinned` when `.tine/key-roles.toml` or a promotion policy pins eval signers (an untrusted one is `lineage.signer-untrusted`) and `unpinned` otherwise: a warning that signers are proven, not trusted. `graph`, `why`, `archive` and `index` read the derived index `LINEAGE_FOLDER/index/lineage.sqlite` (rebuildable, never authoritative): `graph` lists variants and parent edges with `graph_sha256`, equal for equal graphs; `why` walks one variant to every ancestor and its evidence (evals, judges, dataset commitments, approvers, policies, decisions), reporting the index rows `visited`, and carries `check`'s `ok` and `findings` (exit 1 when not ok); `archive` summarises a population with non-linear parents; `index` builds it.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "ok",
        "variant",
        "record",
        "parents",
        "evals",
        "decision"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-lineage/1"
        },
        "command": {
          "const": "lineage record"
        },
        "ok": {
          "const": true
        },
        "variant": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "record": {
          "type": "string"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "evals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eval",
              "verdicts_sha256"
            ],
            "properties": {
              "eval": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "verdicts_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "decision": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "ok",
        "variant",
        "signers",
        "ancestors",
        "findings"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-lineage/1"
        },
        "command": {
          "const": "lineage check"
        },
        "ok": {
          "type": "boolean"
        },
        "variant": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signers": {
          "enum": [
            "pinned",
            "unpinned"
          ]
        },
        "ancestors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "findings": {
          "type": "array",
          "items": {
