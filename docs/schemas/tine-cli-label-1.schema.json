    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema",
        "queue",
        "queue_sha256",
        "rubric_sha256",
        "rubric"
      ],
      "properties": {
        "schema": {
          "const": "tine-cli-label/1"
        },
        "queue": {
          "type": "string"
        },
        "command": {
          "const": "label init"
        },
        "queue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
