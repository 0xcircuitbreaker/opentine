{
  "name": "@opentine/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the OpenTine remote API v1 (docs/api/openapi-v1.yaml). Needs only fetch; @opentine/sdk/verified checks every fetched byte with the TS verifier.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./verified": {
      "types": "./dist/src/verified.d.ts",
      "default": "./dist/src/verified.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/client.test.js dist/test/verified.test.js"
  },
  "peerDependencies": {
    "@opentine/verify": "*"
  },
  "peerDependenciesMeta": {
    "@opentine/verify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentine/verify": "file:../verifier",
    "@types/node": "20.14.10",
    "typescript": "5.6.3"
  }
}
