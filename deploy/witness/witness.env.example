# Non-secret witness configuration (copy to witness.env). Keys are never set here:
# mount them read-only as /run/secrets/witness-*.key.
WITNESS_NAME=witness.example.org
# Space-separated signed-note vkeys of the logs this witness cosigns (from the
# hosted log's opentine-witness-network/1 registry, field log.vkey).
WITNESS_LOG_VKEYS=log.opentine.example/main+00000000+REPLACE_WITH_THE_REGISTRY_LOG_VKEY
WITNESS_LISTEN=0.0.0.0:8080
WITNESS_RATE_LIMIT=60
